{
  "name": "harness-updater",
  "version": "0.1.0",
  "private": true,
  "description": "Docker service that triages the harness repository's retro and quarantine issues against the projects that use the harness, then has the harness loop build the accepted ones.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "updater": "tsx src/cli.ts",
    "check": "pnpm typecheck && pnpm format:check && pnpm secrets:check && pnpm harness:check && pnpm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:check": "node scripts/check-secrets.mjs",
    "harness:check": "harness check",
    "harness:feature": "harness feature",
    "harness:verify": "harness verify",
    "harness:clean-state": "harness clean-state",
    "harness:loop": "harness loop",
    "harness:report": "harness report",
    "harness:doctor": "harness doctor",
    "harness:update": "harness update",
    "harness:selftest": "harness selftest",
    "prepare": "husky"
  },
  "dependencies": {
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eemelinen/harness": "github:Eemelinen/harness#v0.3.5",
    "@types/node": "^22.20.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
