# Copy to .env (gitignored) and fill in. Never commit real values: this repository is public.
# observe: triage and log only · triage: post verdicts · full: post verdicts and build
UPDATER_MODE=observe
# Run `claude setup-token` on the host and paste the token it prints.
CLAUDE_CODE_OAUTH_TOKEN=
# Fine-grained personal access token (README.md → Tokens).
GH_TOKEN=
# The identity of commits the harness loop makes.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# Optional overrides:
# HOST_PROJECTS=/home/eemeli/projects
# UPDATER_UID=1001
# UPDATER_GID=1001
